		(uuid "fec329b5-4841-4a63-bf93-e158e16d37c4")
		(cells
			(table_cell "Key changes from Rev01"
				(exclude_from_sim no)
				(at 101.092 168.91 0)
				(size 72.898 4.572)
				(margins 0.9525 0.9525 0.9525 0.9525)
				(span 1 1)
				(fill
					(type none)
				)
				(effects
					(font
						(size 1.27 1.27)
						(thickness 0.254)
						(bold yes)
					)
					(justify left)
				)
				(uuid "4cca991a-a957-429f-a98f-1ab768b55c4c")
			)
			(table_cell "1. 64 pin CPLD used in place of 44 pin CPLD\n2. Both 16MHz and 48MHz clocks wired into CPLD\n3. CLK_SEL input added to CPLD. Pull up & solder jumper added\n4. Schmitt-triggered buffer & series resistor added to 16MHz clock\n   to filter out spurious clock edges\n5. Schmitt-trigger buffers added to CPLD clock outputs\n6. SRAM_~{WE} pull up removed\n7. Pull up added for JTAG TCK, TMS & TDI signals\n8. SRAM (and decoupling cap) can now be powered from either\n   5v or 3v3 rail via solder jumper"
				(exclude_from_sim no)
				(at 101.092 173.482 0)
				(size 72.898 22.098)
				(margins 0.9525 0.9525 0.9525 0.9525)
				(span 1 1)
				(fill
					(type none)
				)
				(effects
					(font
						(size 1.27 1.27)
					)
					(justify left top)
				)
				(uuid "affc11fd-73c1-4d0b-9c4a-97bfc2b9d1da")
			)
		)
	)
